@model ErrorViewModel
@{
    ViewData["Title"] = "Bir Hata Oluştu";
}

<div class="empty-state" style="padding:4rem 1rem">
    <i class="bi bi-exclamation-octagon" style="color:var(--danger)"></i>
    <h4 style="color:var(--ink-900)">Bir hata oluştu</h4>
    <p>İsteğiniz işlenirken beklenmeyen bir sorunla karşılaşıldı.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-3">
            <span class="text-muted">İstek kimliği:</span> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary mt-2" href="@Url.Action("Index","Home")">
        <i class="bi bi-house"></i> Ana Sayfaya Dön
    </a>
</div>
