@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}
<h2>@ViewData["Title"]</h2>

<table class="table">
    <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Mevcut Rol</th><th>Rol Ata</th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        var current = userRoles != null && userRoles.TryGetValue(u.Id, out var rs) ? string.Join(", ", rs) : "";
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@current</td>
            <td>
                <form asp-action="AssignRole" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@u.Id" />
                    <select name="role" class="form-select form-select-sm">
                        @foreach (var r in Roles.All)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-primary">Ata</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
