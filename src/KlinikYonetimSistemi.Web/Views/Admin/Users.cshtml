@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    ViewData["Subtitle"] = "Tüm kullanıcılar ve rol atamaları";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-person-slash"></i>
        <div>Kayıtlı kullanıcı bulunmuyor.</div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Mevcut Rol</th>
                    <th style="width:360px">Rol Ata</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model)
            {
                var current = userRoles != null && userRoles.TryGetValue(u.Id, out var rs) ? string.Join(", ", rs) : "";
                <tr>
                    <td class="fw-semibold">@u.FullName</td>
                    <td class="text-muted">@u.Email</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(current))
                        {
                            <span class="badge badge-role">@current</span>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                    <td>
                        <form asp-action="AssignRole" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.Id" />
                            <select name="role" class="form-select form-select-sm">
                                @foreach (var r in Roles.All)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-primary">
                                <i class="bi bi-check2"></i> Ata
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
