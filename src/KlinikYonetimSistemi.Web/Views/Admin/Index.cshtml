@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Yönetim Paneli";
    ViewData["Subtitle"] = "Klinik geneline ait özet metrikler ve son randevular";
    var stats = ViewBag.Stats;
}

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="stat-card brand">
            <div class="icon"><i class="bi bi-people"></i></div>
            <div>
                <div class="label">Kullanıcılar</div>
                <div class="value">@stats.TotalUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card info">
            <div class="icon"><i class="bi bi-person-badge"></i></div>
            <div>
                <div class="label">Doktorlar</div>
                <div class="value">@stats.TotalDoctors</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card ok">
            <div class="icon"><i class="bi bi-person-heart"></i></div>
            <div>
                <div class="label">Hastalar</div>
                <div class="value">@stats.TotalPatients</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card dark">
            <div class="icon"><i class="bi bi-calendar3"></i></div>
            <div>
                <div class="label">Toplam Randevu</div>
                <div class="value">@stats.TotalAppointments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card warn">
            <div class="icon"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="label">Bekleyen</div>
                <div class="value">@stats.UpcomingAppointments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card rose">
            <div class="icon"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="label">Tamamlanan</div>
                <div class="value">@stats.CompletedAppointments</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-2">
    <div class="section-title m-0"><i class="bi bi-clock-history"></i> Son Randevular</div>
    <a class="btn btn-outline-primary btn-sm" asp-action="Users">
        <i class="bi bi-person-gear"></i> Kullanıcı Yönetimi
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-calendar-x"></i>
        <div>Henüz randevu kaydı bulunmuyor.</div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Oluşturulma</th>
                    <th>Doktor</th>
                    <th>Hasta</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@a.Doctor?.User?.FullName</td>
                    <td>@a.Patient?.User?.FullName</td>
                    <td>@a.ScheduledAt.ToLocalTime().ToString("g")</td>
                    <td>
                        @switch (a.Status)
                        {
                            case AppointmentStatus.Scheduled: <span class="badge badge-status badge-scheduled"><i class="bi bi-clock"></i> Planlandı</span> break;
                            case AppointmentStatus.Confirmed: <span class="badge badge-status badge-confirmed"><i class="bi bi-check-circle"></i> Onaylandı</span> break;
                            case AppointmentStatus.Completed: <span class="badge badge-status badge-completed"><i class="bi bi-check2-all"></i> Tamamlandı</span> break;
                            case AppointmentStatus.Cancelled: <span class="badge badge-status badge-cancelled"><i class="bi bi-x-circle"></i> İptal</span> break;
                            case AppointmentStatus.NoShow:    <span class="badge badge-status badge-noshow"><i class="bi bi-exclamation-triangle"></i> Gelmedi</span> break;
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
