@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Yönetim Paneli";
    var stats = ViewBag.Stats;
}
<h2>@ViewData["Title"]</h2>

<div class="row g-3 mb-4">
    <div class="col-md-2"><div class="card text-bg-primary"><div class="card-body"><h6>Kullanıcılar</h6><h3>@stats.TotalUsers</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-info"><div class="card-body"><h6>Doktorlar</h6><h3>@stats.TotalDoctors</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-success"><div class="card-body"><h6>Hastalar</h6><h3>@stats.TotalPatients</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-secondary"><div class="card-body"><h6>Toplam Randevu</h6><h3>@stats.TotalAppointments</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-warning"><div class="card-body"><h6>Bekleyen</h6><h3>@stats.UpcomingAppointments</h3></div></div></div>
    <div class="col-md-2"><div class="card text-bg-dark"><div class="card-body"><h6>Tamamlanan</h6><h3>@stats.CompletedAppointments</h3></div></div></div>
</div>

<h3>Son Randevular</h3>
<table class="table table-striped">
    <thead><tr><th>Oluşturulma</th><th>Doktor</th><th>Hasta</th><th>Tarih</th><th>Durum</th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>@a.Doctor?.User?.FullName</td>
            <td>@a.Patient?.User?.FullName</td>
            <td>@a.ScheduledAt.ToLocalTime().ToString("g")</td>
            <td>@a.Status</td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-outline-primary" asp-action="Users">Kullanıcı Yönetimi →</a>
