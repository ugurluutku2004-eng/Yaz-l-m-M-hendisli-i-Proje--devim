@model Patient
@{
    ViewData["Title"] = Model.User?.FullName ?? "Hasta";
    ViewData["Subtitle"] = "Hasta profili ve tıbbi kayıtları";
    var canWrite = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Doctor);
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-person-vcard"></i> Hasta Bilgileri</h5>
                <dl class="kv-grid row mb-0">
                    <dt class="col-sm-5">E-posta</dt>
                    <dd class="col-sm-7">@Model.User?.Email</dd>
                    <dt class="col-sm-5">Doğum Tarihi</dt>
                    <dd class="col-sm-7">@(Model.DateOfBirth?.ToString("d") ?? "—")</dd>
                    <dt class="col-sm-5">Kan Grubu</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrWhiteSpace(Model.BloodType))
                        {
                            <span class="chip"><i class="bi bi-droplet-fill"></i> @Model.BloodType</span>
                        }
                        else { <text>—</text> }
                    </dd>
                    <dt class="col-sm-5">Alerjiler</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Allergies) ? "—" : Model.Allergies)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-journal-medical"></i> Tıbbi Kayıtlar</h5>
                @if (!Model.MedicalRecords.Any())
                {
                    <div class="empty-state" style="padding:2rem 1rem">
                        <i class="bi bi-file-earmark-medical"></i>
                        <div>Kayıt bulunmuyor.</div>
                    </div>
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var r in Model.MedicalRecords.OrderByDescending(r => r.RecordedAt))
                        {
                            <li>
                                <div class="when">@r.RecordedAt.ToLocalTime().ToString("g")</div>
                                <div class="fw-semibold mb-1">@r.Diagnosis</div>
                                @if (!string.IsNullOrWhiteSpace(r.Treatment))
                                {
                                    <div class="text-muted"><strong style="color:var(--ink-700)">Tedavi:</strong> @r.Treatment</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(r.Prescription))
                                {
                                    <div class="text-muted"><strong style="color:var(--ink-700)">Reçete:</strong> @r.Prescription</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @if (canWrite)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-plus-square"></i> Yeni Tıbbi Kayıt</h5>
                    <form asp-action="AddMedicalRecord" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="patientId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Tanı *</label>
                            <input name="diagnosis" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tedavi</label>
                            <textarea name="treatment" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reçete</label>
                            <textarea name="prescription" class="form-control" rows="2"></textarea>
                        </div>
                        <button class="btn btn-primary">
                            <i class="bi bi-save"></i> Kaydet
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
