@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Randevular";
    ViewData["Subtitle"] = "Planlanan ve geçmiş tüm randevularınız";
}

@if (User.IsInRole(Roles.Patient))
{
    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Yeni Randevu
        </a>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-calendar-x"></i>
        <div>Henüz bir randevu kaydı bulunmuyor.</div>
        @if (User.IsInRole(Roles.Patient))
        {
            <a class="btn btn-primary mt-3" asp-action="Create">
                <i class="bi bi-plus-circle"></i> İlk randevunuzu oluşturun
            </a>
        }
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Tarih / Saat</th>
                    <th>Doktor</th>
                    <th>Hasta</th>
                    <th>Durum</th>
                    <th>Süre</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@a.ScheduledAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                        <small class="text-muted">@a.ScheduledAt.ToLocalTime().ToString("HH:mm")</small>
                    </td>
                    <td>
                        <div>@a.Doctor?.User?.FullName</div>
                        <small class="text-muted">@a.Doctor?.Specialty?.Name</small>
                    </td>
                    <td>@a.Patient?.User?.FullName</td>
                    <td>
                        @switch (a.Status)
                        {
                            case AppointmentStatus.Scheduled: <span class="badge badge-status badge-scheduled"><i class="bi bi-clock"></i> Planlandı</span> break;
                            case AppointmentStatus.Confirmed: <span class="badge badge-status badge-confirmed"><i class="bi bi-check-circle"></i> Onaylandı</span> break;
                            case AppointmentStatus.Completed: <span class="badge badge-status badge-completed"><i class="bi bi-check2-all"></i> Tamamlandı</span> break;
                            case AppointmentStatus.Cancelled: <span class="badge badge-status badge-cancelled"><i class="bi bi-x-circle"></i> İptal</span> break;
                            case AppointmentStatus.NoShow:    <span class="badge badge-status badge-noshow"><i class="bi bi-exclamation-triangle"></i> Gelmedi</span> break;
                        }
                    </td>
                    <td>@a.DurationMinutes dk</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@a.Id">
                            Detay <i class="bi bi-arrow-right"></i>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
