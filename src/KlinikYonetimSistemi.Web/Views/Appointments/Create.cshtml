@model AppointmentCreateVm
@{
    ViewData["Title"] = "Yeni Randevu";
    ViewData["Subtitle"] = "Uygun bir doktor ve zaman seçerek randevu oluşturun";
    var doctors = ViewBag.Doctors as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-calendar-plus"></i> Randevu Detayları</h5>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                    <div class="mb-3">
                        <label asp-for="DoctorId" class="form-label"></label>
                        <select asp-for="DoctorId" class="form-select" asp-items="doctors">
                            <option value="">-- Doktor seçin --</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="ScheduledAt" class="form-label"></label>
                            <input asp-for="ScheduledAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ScheduledAt" class="text-danger"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="DurationMinutes" class="form-label"></label>
                            <input asp-for="DurationMinutes" class="form-control" />
                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Başvurunuzun nedenini kısaca belirtin..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2"></i> Randevu Oluştur
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
