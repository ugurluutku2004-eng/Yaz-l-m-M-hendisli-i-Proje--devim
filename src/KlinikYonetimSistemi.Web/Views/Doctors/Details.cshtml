@model Doctor
@{
    ViewData["Title"] = Model.User?.FullName ?? "Doktor";
}
<h2>@ViewData["Title"]</h2>
<p class="text-muted">@Model.Specialty?.Name • @Model.YearsOfExperience yıl tecrübe</p>

<dl class="row">
    <dt class="col-sm-3">Diploma No</dt>
    <dd class="col-sm-9">@Model.LicenseNumber</dd>
    <dt class="col-sm-3">E-posta</dt>
    <dd class="col-sm-9">@Model.User?.Email</dd>
    <dt class="col-sm-3">Özgeçmiş</dt>
    <dd class="col-sm-9">@Model.Bio</dd>
</dl>

@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canEdit = User.IsInRole(Roles.Admin) || Model.UserId == userId;
}

@if (canEdit)
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
}
<a asp-action="Index" class="btn btn-link">← Geri</a>
