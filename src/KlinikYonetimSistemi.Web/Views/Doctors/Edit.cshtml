@model Doctor
@{
    ViewData["Title"] = "Doktor Profili Düzenle";
    ViewData["Subtitle"] = Model.User?.FullName;
    var specialties = ViewBag.Specialties as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-person-gear"></i> Profil Bilgileri</h5>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                    <div class="mb-3">
                        <label class="form-label">Uzmanlık</label>
                        <select asp-for="SpecialtyId" class="form-select" asp-items="specialties"></select>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label">Diploma No</label>
                            <input asp-for="LicenseNumber" class="form-control" />
                            <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="YearsOfExperience" class="form-label">Tecrübe (yıl)</label>
                            <input asp-for="YearsOfExperience" class="form-control" />
                            <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Bio" class="form-label">Özgeçmiş</label>
                        <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary">
                            <i class="bi bi-save"></i> Kaydet
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="bi bi-x"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
