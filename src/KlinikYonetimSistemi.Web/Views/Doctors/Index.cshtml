@model IEnumerable<Doctor>
@{
    ViewData["Title"] = "Doktorlar";
    var specialties = ViewBag.Specialties as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<h2>@ViewData["Title"]</h2>

<form method="get" class="row g-2 mb-3 align-items-end col-md-6">
    <div class="col">
        <label class="form-label">Uzmanlık</label>
        <select name="specialtyId" class="form-select" asp-items="specialties">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Filtrele</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr><th>Ad Soyad</th><th>Uzmanlık</th><th>Tecrübe</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.User?.FullName</td>
            <td>@d.Specialty?.Name</td>
            <td>@d.YearsOfExperience yıl</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@d.Id">Detay</a></td>
        </tr>
    }
    </tbody>
</table>
