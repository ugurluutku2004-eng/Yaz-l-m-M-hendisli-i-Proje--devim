@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-head">
            <div class="auth-logo"><i class="bi bi-heart-pulse-fill"></i></div>
            <h1>Kayıt Ol</h1>
            <p>Randevu alabilmek için bir hasta hesabı oluşturun.</p>
        </div>

        <form id="registerForm" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name"
                       aria-required="true" placeholder="Ad Soyad" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NationalId" class="form-label"></label>
                <input asp-for="Input.NationalId" class="form-control" inputmode="numeric"
                       maxlength="11" placeholder="11 haneli" />
                <span asp-validation-for="Input.NationalId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username"
                       aria-required="true" placeholder="ornek@klinik.local" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="form-text mb-3 mt-2">
                Şifre en az 8 karakter olmalı; büyük harf, rakam ve özel karakter içermelidir.
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary w-100">
                <i class="bi bi-person-plus"></i> Hesap Oluştur
            </button>
        </form>

        <div class="auth-foot">
            Zaten hesabınız var mı? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Giriş yapın</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
